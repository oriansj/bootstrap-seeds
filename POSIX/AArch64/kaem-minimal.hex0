#:ELF_base

7F 45 4C 46                    # e_ident[EI_MAG0-3] ELF's magic number

02                             # e_ident[EI_CLASS] Indicating 64 bit
01                             # e_ident[EI_DATA] Indicating little endianness
01                             # e_ident[EI_VERSION] Indicating original elf

03                             # e_ident[EI_OSABI] Set at 0 because none cares
00                             # e_ident[EI_ABIVERSION] See above

00 00 00 00 00 00 00           # e_ident[EI_PAD]
02 00                          # e_type Indicating Executable
B7 00                          # e_machine Indicating AArch64
01 00 00 00                    # e_version Indicating original elf

78 00 60 00 00 00 00 00          # e_entry Address of the entry point
40 00 00 00 00 00 00 00 # e_phoff Address of program header table
00 00 00 00 00 00 00 00 # e_shoff Address of section header table

00 00 00 00                    # e_flags
40 00                          # e_ehsize Indicating our 64 Byte header

38 00                          # e_phentsize size of a program header table
01 00                          # e_phnum number of entries in program table

00 00                          # e_shentsize size of a section header table
00 00                          # e_shnum number of entries in section table

00 00                          # e_shstrndx index of the section names

#:ELF_program_headers
#:ELF_program_header__text
01 00 00 00                   # ph_type: PT-LOAD = 1
07 00 00 00                   # ph_flags: PF-X|PF-W|PF-R = 7
00 00 00 00 00 00 00 00                   # ph_offset
00 00 60 00 00 00 00 00                     # ph_vaddr
00 00 60 00 00 00 00 00                     # ph_physaddr
BA 02 00 00 00 00 00 00             # ph_filesz
BA 02 00 00 00 00 00 00             # ph_memsz
01 00 00 00 00 00 00 00                   # ph_align



#:ELF_text
# Where the ELF Header is going to hit
# Simply jump to _start
# Our main function
#:_start
    e10b40f9                    ; LDR_X1_[SP,16]              # Get the actual input name
    f4830091                    ; ADD_X20_SP_32               # Get envp (hopefullY)
    610000b5                    ; CBNZ_X1_OPEN_SCRIPT         # Have real input
    f4630091                    ; ADD_X20_SP_24               # Nope, envp is here!
    e10f0010                    ; ADR_X1_DEFAULT_FILE         # Use "kaem.aarch64"

#:open_script
    600c8092                    ; SET_X0_TO_FCNTL_H_AT_FDCWD  # AT_FDCWD, relative to current working directory
    020080d2                    ; SET_X2_TO_0                 # prepare read_only
    080780d2                    ; SET_X8_TO_SYS_OPENAT        # the syscall number for openat()
    010000d4                    ; SYSCALL                     # Now open that damn file
    1f0000f1                    ; CMP_X0_TO_0                 # IF NULL We couldn't open the file
    ad0b0054                    ; B_LE_EXIT                   # Abort hard
    f30300aa                    ; SET_X19_FROM_X0             # Set input pointer
    ff4302d1                    ; SUB_SP_SP_144               # Reserve 128 bytes for siginfo and a separate read byte

    000080d2                    ; SET_X0_TO_0                 # Get current brk
    c81a80d2                    ; SET_X8_TO_SYS_BRK           # the Syscall # for SYS_BRK
    010000d4                    ; SYSCALL                     # Let the kernel do the work
    f50300aa                    ; SET_X21_FROM_X0             # Set our malloc pointer

#:command
    # Where the main work gets done
    000081d2                    ; SET_X0_TO_2048              # Using 256 char* of space
    570000 94                   ; ^~malloc FCALL              # get it
    f60300aa                    ; SET_X22_FROM_X0             # set tokens
    f70300aa                    ; SET_X23_FROM_X0             # I = 0
    ff0f00f9                    ; STR_XZR_[SP,24]             # status = 0

#:word
    000082d2                    ; SET_X0_TO_4096              # Using max_string
    520000 94                   ; ^~malloc FCALL              # allocate space
    f80300aa                    ; SET_X24_FROM_X0             # token = malloc(max_string);
    f90300aa                    ; SET_X25_FROM_X0             # i = 0; set token[i]

#:scan
    560000 94                   ; ^~fgetc FCALL               # c = fgetc(input);
    1ff00371                    ; CMP_W0_TO_252               # if C == EOF
    40090054                    ; B_EQ_DONE
    1f280071                    ; CMP_W0_TO_10                # IF C == '\n'
    a0030054                    ; B_EQ_LINE_END
    1f800071                    ; CMP_W0_TO_32                # IF C == ' '
    0418497a                    ; CCMP_W0_9_4_NE              # IF C == '\t'
    20020054                    ; B_EQ_WORD_END
    1f880071                    ; CMP_W0_TO_34                # IF C == '\"'
    e0000054                    ; B_EQ_QUOTED
    1f8c0071                    ; CMP_W0_TO_35                # IF C == '#'
    20020054                    ; B_EQ_COMMENT
    1f700171                    ; CMP_W0_TO_92                # IF C == '\\'
    40010054                    ; B_EQ_ESCAPED
    20170038                    ; STRB_W0_[X25]_POST_1        # token[i] = C
    f1ffff 17                   ; ^~scan RBRANCH              # Keep going

#:quoted
    # It is a RAW STRING
    460000 94                   ; ^~fgetc FCALL               # C = fgetc(input)
    1ff00371                    ; CMP_W0_TO_252               # if C == EOF
    60070054                    ; B_EQ_EXIT                   # Something went horribly wrong
    1f880071                    ; CMP_W0_TO_34
    80000054                    ; B_EQ_WORD_END_FROM_QUOTED   # be done
    20170038                    ; STRB_W0_[X25]_POST_1        # target[index] = C
    faffff 17                   ; ^~quoted RBRANCH            # Keep going

#:escaped
    # It is an escape char
    3f0000 94                   ; ^~fgetc FCALL               # Read the char to drop

#:word_end
    1f0319eb                    ; CMP_X24_TO_X25              # IF i == 0
    60fcff54                    ; B_EQ_WORD                   # Skip an empty word
    f88600f8                    ; STR_X24_[X23]_POST_8        # tokens[i] = result
    e1ffff 17                   ; ^~word RBRANCH

#:comment
# Just throws away everything it reads
    3a0000 94                   ; ^~fgetc FCALL               # C = fgetc(input)
    1ff00371                    ; CMP_W0_TO_252               # IF C == EOF
    e0050054                    ; B_EQ_EXIT_FROM_COMMENT      # abort hard
    1f280071                    ; CMP_W0_TO_10                # IF C == '\n'
    81ffff54                    ; B_NE_COMMENT                # otherwise keep looping

#:line_end
    1f0319eb                    ; CMP_X24_TO_X25
    40000054                    ; B_EQ_RUN                    # Nothing to append for an empty final word
    f88600f8                    ; STR_X24_[X23]_POST_8        # tokens[i] = result

#:run
    df0217eb                    ; CMP_X22_TO_X23
    40faff54                    ; B_EQ_COMMAND                # Skip a blank command
    c1080030                    ; ADR_X1_PREFIX               # using " +> "
    380000 94                   ; ^~File_Print FCALL          # print it
    fa0316aa                    ; SET_X26_FROM_X22            # Walk argv without changing its base

#:print_arg
    418740f8                    ; LDR_X1_[X26]_POST_8         # using tokens[j]
    350000 94                   ; ^~File_Print FCALL          # print it
    41080050                    ; ADR_X1_SPACE                # using ' '
    330000 94                   ; ^~File_Print FCALL          # print it
    5f0317eb                    ; CMP_X26_TO_X23
    61ffff54                    ; B_NE_PRINT_ARG              # Stop at the next unused argv slot
    e1070010                    ; ADR_X1_NEWLINE              # using '\n'
    2f0000 94                   ; ^~File_Print FCALL          # print it
    c00240f9                    ; LDR_X0_[X22]                # program = tokens[0]
    600300b4                    ; CBZ_X0_EXIT                 # IF NULL == program
    200280d2                    ; SET_X0_TO_17                # flags = SIGCHILD
    010080d2                    ; SET_X1_TO_0                 # parent_tid
    020080d2                    ; SET_X2_TO_0                 # tls
    030080d2                    ; SET_X3_TO_0                 # child_tid
    881b80d2                    ; SET_X8_TO_SYS_CLONE         # FORKing (SYS_clone)
    010000d4                    ; SYSCALL                     # int f = clone()
    1f0000f1                    ; CMP_X0_TO_0                 # Check fork
    6b020054                    ; B_LT_EXIT                   # IF f == -1 abort hard
    e1000054                    ; B_NE_PARENT                 # Only the child calls execve
    c00240f9                    ; LDR_X0_[X22]                # program = tokens[0]
    e10316aa                    ; SET_X1_FROM_X22
    e20314aa                    ; SET_X2_FROM_X20             # third arg = envp
    a81b80d2                    ; SET_X8_TO_SYS_EXECVE        # EXECVE
    010000d4                    ; SYSCALL                     # execve(program, tokens, envp);
    0c0000 14                   ; ^~exit FBRANCH              # return error

#:parent
    e10300aa                    ; SET_X1_FROM_X0              # id = f
    200080d2                    ; SET_X0_TO_1                 # id_type = P_PID
    e2030091                    ; SET_X2_FROM_SP              # infop
    830080d2                    ; SET_X3_TO_4                 #  options = WEXITED
    e80b80d2                    ; SET_X8_TO_SYS_WAITID        # WAITID
    010000d4                    ; SYSCALL
    e00f40f9                    ; LDR_X0_[SP,24]              # Using status
    c0f5ffb4                    ; CBZ_X0_COMMAND              # IF 0 == status
    81040050                    ; ADR_X1_HARD                 # Using "Subprocess error\nABORTING HARD\n"
    140000 94                   ; ^~File_Print FCALL          # Print it

#:done
# program completed Successfully
    000080d2                    ; SET_X0_TO_0                 # All is well

#:exit
    a80b80d2                    ; SET_X8_TO_SYS_EXIT          # put the exit syscall number in x8
    010000d4                    ; SYSCALL


# Malloc isn't actually required if the program being built fits in the initial memory
# However, it doesn't take much to add it.
# Requires X21 to hold the current brk and X0 to have the number of desired bytes
# Returns the old brk in X0
#:malloc
    e90315aa                    ; SET_X9_FROM_X21             # Save to return later
    0000158b                    ; ADD_X0_X0_X21               # Request the number of desired bytes
    c81a80d2                    ; SET_X8_TO_SYS_BRK           # the Syscall # for SYS_BRK
    010000d4                    ; SYSCALL                     # call the Kernel
    f50300aa                    ; SET_X21_FROM_X0             # Update pointer
    e00309aa                    ; SET_X0_FROM_X9              # Return the old break
    c0035fd6                    ; RETURN


# fgetc function
# Loads the script fd from X19
# Returns a byte in W0, or 0xFC on EOF
#:fgetc
    e00313aa                    ; SET_X0_FROM_X19             # Read from the script
    e1030291                    ; ADD_X1_SP_128               # Byte buffer beyond siginfo
    220080d2                    ; SET_X2_TO_1
    891f8052                    ; SET_W9_TO_252               # Leave 0xFC in the buffer if read returns no byte
    29000039                    ; STRB_W9_[X1]
    e80780d2                    ; SET_X8_TO_SYS_READ          # the syscall number for read
    010000d4                    ; SYSCALL                     # call the Kernel
    20004039                    ; LDR_BYTE_W0_[X1]            # Return the byte as an unsigned value
    c0035fd6                    ; RETURN


# File_Print function
# Receives CHAR* in X1
# writes every non-null char to stdout
#:File_Print
    210100b4                    ; CBZ_X1_FILE_PRINT_DONE      # Protect against nulls
    220080d2                    ; SET_X2_TO_1                 # set the size of chars we want
    080880d2                    ; SET_X8_TO_SYS_WRITE         # the syscall number for write

#:File_Print_Loop
    20004039                    ; LDR_BYTE_W0_[X1]            # Read byte
    a0000034                    ; CBZ_W0_FILE_PRINT_DONE      # Check for NULL
    200080d2                    ; SET_X0_TO_1                 # Write to target file
    010000d4                    ; SYSCALL                     # call the Kernel
    21040091                    ; ADD_X1_X1_1                 # S = S + 1
    fbffff 17                   ; ^~File_Print_Loop RBRANCH   # Keep going

#:File_Print_Done
    c0035fd6                    ; RETURN
#:default_file
    6B 61 65 6D 2E 61 61 72 63 68 36 34 00  ; "kaem.aarch64"
#:prefix
    20 2B 3E 20 00              ; " +> "
#:space
    20 00                       ; " "
#:newline
    0A 00                       ; "\n"
#:hard
    53 75 62 70 72 6F 63 65 73 73 20 65 72 72 6F 72 0A  ; "Subprocess error"
    41 42 4F 52 54 49 4E 47 20 48 41 52 44 0A           ; "ABORTING HARD"
    00

#:ELF_end
#:ELF_sym
#:ELF_str
